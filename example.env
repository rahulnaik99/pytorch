# ─────────────────────────────────────────────────────────────────────────────
# Trading LLM Fine-Tune Pipeline — Configuration
# Copy this file to .env and edit the values below.
# All values listed here are the defaults used when a variable is not set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data source ───────────────────────────────────────────────────────────────
# "csv"     → reads from data/prices/<SYMBOL>.csv (fast, no internet)
# "yfinance" → downloads from Yahoo Finance (requires internet)
DATA_SOURCE=csv

# Directory containing price CSV files
CSV_DIR=data/prices

# Path to India VIX CSV (auto-detected as CSV_DIR/INDIAVIX.csv if empty)
VIX_CSV=

# VIX regime thresholds
VIX_LOW=13
VIX_NORMAL=18
VIX_ELEVATED=25

# ── Data generation (pipeline.py) ────────────────────────────────────────────
# NSE symbol to generate data for
SYMBOL=CANBK

# Date range to sample trading days from
START_DATE=2024-01-01
END_DATE=2024-12-31

# How many past daily candles to use for each decision
LOOKBACK_DAYS=90

# Maximum days to hold a trade for outcome simulation
MAX_HOLD_DAYS=5

# Number of random dates to generate per run (pipeline.py picks COUNT random
# weekdays from [START_DATE, END_DATE] that are not already in the DB)
COUNT=10

# ── LLM backend ───────────────────────────────────────────────────────────────
# Ollama settings (used for data generation with the base model)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB:Q4_K_M
# Timeout for each Ollama call in seconds (Nemotron takes ~170s on CPU)
OLLAMA_TIMEOUT=300

# HuggingFace fine-tuned model (set AFTER training to use the fine-tuned model
# for data generation — generates higher-quality training data each round)
# Leave empty to use Ollama for data generation.
HF_MODEL=
HF_ADAPTER=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=trading_agent.db

# ── Trade sizing & Indian transaction costs ───────────────────────────────────
# Fraction of CAPITAL_FOR_QTY to risk per trade (for quantity calculation)
RISK_PER_TRADE=0.02

# Notional capital used to determine trade quantity
CAPITAL_FOR_QTY=10000

# Set to 0 to skip deducting transaction costs from P&L
INCLUDE_COSTS=1

# Indian equity brokerage (flat rate per leg, capped at BROKERAGE_MAX)
BROKERAGE_PCT=0.0003
BROKERAGE_MAX=20.0

# Securities Transaction Tax (on turnover)
STT_PCT=0.001

# NSE exchange transaction charge
EXCH_TXN_PCT=0.0000297

# SEBI turnover fee
SEBI_PCT=0.000001

# GST on brokerage + exchange + SEBI charges
GST_PCT=0.18

# Stamp duty (on buy value only)
STAMP_PCT=0.00015

# ── Training (train.py) ───────────────────────────────────────────────────────
# HuggingFace model name or local path for fine-tuning
BASE_MODEL=nvidia/Nemotron-Mini-4B-Instruct

# Where to save the LoRA adapter
OUTPUT_DIR=output/nemotron-lora

# JSONL splits produced by splitter.py
TRAIN_JSONL=data/trading_train.jsonl
VAL_JSONL=data/trading_val.jsonl

# LoRA hyperparameters
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# Training hyperparameters
EPOCHS=3
LR=2e-4
BATCH_SIZE=1
GRAD_ACCUM=8
MAX_SEQ_LEN=1024

# Logging / checkpoint intervals (in optimizer steps)
LOGGING_STEPS=10
EVAL_STEPS=50
SAVE_STEPS=100

# Set to 1 to mask system+user tokens and only compute loss on assistant tokens.
# This is strongly recommended — it focuses the gradient on the model's own
# output and prevents the model from "memorising" the prompt format.
RESPONSE_ONLY_LOSS=1

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=trading-nemotron-lora

# ── Splitter (splitter.py) ────────────────────────────────────────────────────
# Minimum confidence score to include a trade in training
MIN_CONFIDENCE=0.5

# Minimum risk:reward ratio to include a trade
MIN_RR=1.5

# Walk-forward ratios for train/val/test split
VAL_RATIO=0.1
TEST_RATIO=0.1

# Set to 0 to disable deduplication / balancing
DEDUP_DATA=1
BALANCE_DATA=1

# "time" = chronological walk-forward split (recommended, prevents leakage)
# "random" = random shuffle split
SPLIT_MODE=time

# ── Serve (serve.py) ──────────────────────────────────────────────────────────
# Model path for the serving endpoint (set to fused model after training)
# HF_MODEL=output/nemotron-lora/fused_model
SERVE_HOST=0.0.0.0
SERVE_PORT=8000
